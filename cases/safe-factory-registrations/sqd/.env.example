RPC_ENDPOINT="https://rpc.ankr.com/eth"
DB_PORT=5432

# Where the processor reads chain data: "network" (the default) keeps the SQD
# Network gateway configured, "rpc" drops it and ingests from RPC_ENDPOINT
# alone. The benchmark runs both.
SQD_SOURCE=network

# The SQD Network gateway (v2.archive.subsquid.io) requires an API key as of
# 19 May 2026. Create one at https://portal.sqd.dev and set it here (read
# automatically by the @subsquid archive client). Without it the processor
# fails with CREDENTIALS_INVALID and indexes nothing. SQD_SOURCE=rpc does not
# touch the gateway, so it needs no key.
SQD_API_KEY=
