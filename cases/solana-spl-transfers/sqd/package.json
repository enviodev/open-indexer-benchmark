    "@subsquid/solana-stream": "^1.1.2",
    "@subsquid/typeorm-migration": "^1.4.0",
    "@subsquid/typeorm-store": "^1.9.1",
    "dotenv": "^17.4.2",
    "pg": "^8.22.0",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@subsquid/typeorm-codegen": "^2.2.0",
    "@types/node": "^24.13.3",
