# StreamingFast API key, exchanged for a JWT by the CLI. Keep this file's real
# counterpart (.env) out of git — it is gitignored.
SUBSTREAMS_API_KEY="server_your_key_here"

SUBSTREAMS_ENDPOINT="mainnet.sol.streamingfast.io:443"
DATABASE_URL="postgres://postgres:postgres@localhost:25433/substreams"

# The benchmark runner sets these; they are here so the project runs by hand.
START_SLOT=440000000
END_SLOT=440003999
