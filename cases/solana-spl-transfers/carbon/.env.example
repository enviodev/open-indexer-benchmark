# Solana RPC endpoint the block crawler reads. Keys usually live in the URL, so
# keep this file's real counterpart (.env) out of git — it is gitignored.
SOLANA_RPC_URL="https://your-provider.example/your-key"

DATABASE_URL="postgres://postgres:postgres@localhost:25432/carbon"

# The benchmark runner sets these; they are here so the project runs by hand.
START_SLOT=440000000
END_SLOT=440001999
RUST_LOG=info
