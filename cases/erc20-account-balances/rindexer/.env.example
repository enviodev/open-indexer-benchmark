# Ethereum RPC endpoint
ETHEREUM_RPC=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# PostgreSQL connection (used by docker-compose and rindexer)
POSTGRES_PASSWORD=rindexer
DATABASE_URL=postgresql://postgres:rindexer@localhost:5440/postgres

# Data source: false is the plain RPC pipeline; true routes historical log
# fetches through HyperSync (requires rindexer v0.43.0+ and ENVIO_API_TOKEN,
# https://envio.dev/app/api-tokens).
RINDEXER_HYPERSYNC=false
# ENVIO_API_TOKEN=your-token
