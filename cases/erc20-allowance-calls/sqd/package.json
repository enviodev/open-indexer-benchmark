{
  "name": "squid-erc20-allowance-calls",
  "private": true,
  "scripts": {
    "build": "rm -rf lib && tsc",
    "codegen": "squid-typeorm-codegen",
    "typegen": "squid-evm-typegen ./src/abi ./abi/*.json",
    "process": "node --require=dotenv/config lib/main.js",
    "serve": "squid-graphql-server",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@subsquid/evm-abi": "^0.3.1",
    "@subsquid/evm-codec": "^0.3.0",
    "@subsquid/evm-processor": "^1.30.1",
    "@subsquid/graphql-server": "^4.12.0",
    "@subsquid/rpc-client": "^4.16.0",
    "@subsquid/typeorm-migration": "^1.3.1",
    "@subsquid/typeorm-store": "^1.9.1",
    "@subsquid/util-internal": "^3.3.0",
    "dotenv": "^16.6.1",
    "pg": "^8.20.0",
    "typeorm": "^0.3.29"
  },
  "devDependencies": {
    "@subsquid/evm-typegen": "^4.6.0",
    "@subsquid/typeorm-codegen": "^2.2.0",
    "@types/node": "^20.19.41",
    "typescript": "~5.5.4"
  }
}
